@model IEnumerable<InternetShop.Models.Product>

@{
    ViewData["Title"] = "Товары";
}

<h1>Товары</h1>

<p>
    <a asp-action="Create" class="btn btn-success mb-3"><i class="bi bi-plus-circle"></i> Добавить товар</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Название
            </th>
            <th>
                Описание
            </th>
            <th>
                Цена
            </th>
            <th>
                В наличии
            </th>
            <th>
                Действия
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Stock)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm me-1" title="Редактировать"><i class="bi bi-pencil"></i> Редактировать</a>
<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-1" title="Подробнее"><i class="bi bi-eye"></i> Подробнее</a>
<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Удалить"><i class="bi bi-trash"></i> Удалить</a>
            </td>
        </tr>
}
    </tbody>
</table>