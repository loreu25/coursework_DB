@model InternetShop.Models.User

@{
    ViewData["Title"] = "Удаление пользователя";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi bi-person-x-fill text-danger"></i> Удаление пользователя</h1>
    <div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> К списку
        </a>
    </div>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <h5 class="card-title text-danger mb-4">Вы уверены, что хотите удалить этого пользователя?</h5>
        <dl class="row">
            <dt class="col-sm-3">ФИО</dt>
            <dd class="col-sm-9">@Model.LastName @Model.FirstName @Model.Patronymic</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
        </dl>

        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            Это действие нельзя будет отменить. Все данные пользователя будут удалены.
        </div>

        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Удалить
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x"></i> Отмена
            </a>
        </form>
    </div>
</div>
