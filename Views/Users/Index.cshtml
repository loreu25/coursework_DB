@model IEnumerable<InternetShop.Models.User>

@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi bi-people-fill text-primary"></i> Пользователи</h1>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="SearchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Поиск по имени или email..." />
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Поиск
        </button>
        @if (!String.IsNullOrEmpty(ViewBag.CurrentFilter))
        {
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Сбросить
            </a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle border rounded shadow-sm">
        <thead class="table-light">
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSortParm" asp-route-searchString="@ViewBag.CurrentFilter">
                        ФИО
                        @if (String.IsNullOrEmpty(ViewBag.CurrentSort)) { <span>▲</span> }
                        @if ((ViewBag.CurrentSort as string) == "name_desc") { <span>▼</span> }
                    </a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewBag.EmailSortParm" asp-route-searchString="@ViewBag.CurrentFilter">
                        Email
                        @if ((ViewBag.CurrentSort as string) == "Email") { <span>▲</span> }
                        @if ((ViewBag.CurrentSort as string) == "email_desc") { <span>▼</span> }
                    </a>
                </th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.LastName @item.FirstName @item.Patronymic</td>
                    <td>@item.Email</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-1" title="Подробности">
                            <i class="bi bi-info-circle"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Удалить">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
