@model InternetShop.Models.User

@{
    ViewData["Title"] = "Информация о пользователе";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi bi-person-circle text-primary"></i> Информация о пользователе</h1>
    <div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> К списку
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-4">Личные данные</h5>
        <dl class="row">
            <dt class="col-sm-3">ФИО</dt>
            <dd class="col-sm-9">@Model.LastName @Model.FirstName @Model.Patronymic</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
        </dl>

        <h5 class="card-title mb-4 mt-4">История заказов</h5>
        @if (Model.Orders != null && Model.Orders.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Номер</th>
                            <th>Дата</th>
                            <th>Статус</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@order.Status.ToString().Replace("_", " ")</td>
                                <td class="text-end">
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-info-circle"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">У пользователя пока нет заказов.</p>
        }
    </div>
</div>
