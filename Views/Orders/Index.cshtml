@model IEnumerable<InternetShop.Models.Order>

@{
    ViewData["Title"] = "Заказы";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi bi-bag-check-fill text-warning"></i> Заказы</h1>
    @if (!User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="bi bi-plus-circle"></i> Новый заказ
        </a>
    }
</div>

<form method="get" asp-action="Index" class="mb-3 d-flex flex-wrap gap-2 align-items-end">
    <div>
        <label for="dateFrom" class="form-label mb-0">С даты:</label>
        <input type="date" id="dateFrom" name="dateFrom" class="form-control" value="@(ViewBag.DateFrom)" />
    </div>
    <div>
        <label for="dateTo" class="form-label mb-0">По дату:</label>
        <input type="date" id="dateTo" name="dateTo" class="form-control" value="@(ViewBag.DateTo)" />
    </div>

    <div>
        <label for="customerId" class="form-label mb-0">Пользователь:</label>
        <select id="customerId" name="customerId" class="form-select" asp-items="ViewBag.Users">
            <option value="">Все</option>
        </select>
    </div>
    <div>
        <label for="status" class="form-label mb-0">Статус:</label>
        <select id="status" name="status" class="form-select" asp-items="ViewBag.Statuses">
            <option value="">Все</option>
        </select>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Фильтровать</button>
        <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
    </div>
</form>
<div class="table-responsive">
    <table class="table table-hover align-middle border rounded shadow-sm">
        <thead class="table-light">
            <tr>
                <th>
    <a asp-action="Index" asp-route-sortOrder="@(ViewBag.IdSortParm)" asp-route-customerId="@(ViewBag.SelectedCustomerId)" asp-route-status="@(ViewBag.SelectedStatus)" asp-route-dateFrom="@(ViewBag.DateFrom)" asp-route-dateTo="@(ViewBag.DateTo)">Номер
        @if ((ViewBag.CurrentSort as string) == "Id") { <span>▲</span> }
        @if ((ViewBag.CurrentSort as string) == "id_desc") { <span>▼</span> }
    </a>
</th>
<th>
    <a asp-action="Index" asp-route-sortOrder="@(ViewBag.UserSortParm)" asp-route-customerId="@(ViewBag.SelectedCustomerId)" asp-route-status="@(ViewBag.SelectedStatus)" asp-route-dateFrom="@(ViewBag.DateFrom)" asp-route-dateTo="@(ViewBag.DateTo)">Пользователь
        @if ((ViewBag.CurrentSort as string) == "User") { <span>▲</span> }
        @if ((ViewBag.CurrentSort as string) == "user_desc") { <span>▼</span> }
    </a>
</th>
<th>
    <a asp-action="Index" asp-route-sortOrder="@(ViewBag.DateSortParm)" asp-route-customerId="@(ViewBag.SelectedCustomerId)" asp-route-status="@(ViewBag.SelectedStatus)" asp-route-dateFrom="@(ViewBag.DateFrom)" asp-route-dateTo="@(ViewBag.DateTo)">Дата заказа
        @if ((ViewBag.CurrentSort as string) == "Date") { <span>▲</span> }
        @if ((ViewBag.CurrentSort as string) == "date_desc") { <span>▼</span> }
    </a>
</th>
<th>
    <a asp-action="Index" asp-route-sortOrder="@(ViewBag.StatusSortParm)" asp-route-customerId="@(ViewBag.SelectedCustomerId)" asp-route-status="@(ViewBag.SelectedStatus)" asp-route-dateFrom="@(ViewBag.DateFrom)" asp-route-dateTo="@(ViewBag.DateTo)">Статус
        @if ((ViewBag.CurrentSort as string) == "Status") { <span>▲</span> }
        @if ((ViewBag.CurrentSort as string) == "status_desc") { <span>▼</span> }
    </a>
</th>
<th>
    <a asp-action="Index" asp-route-sortOrder="@(ViewBag.CountSortParm)" asp-route-customerId="@(ViewBag.SelectedCustomerId)" asp-route-status="@(ViewBag.SelectedStatus)" asp-route-dateFrom="@(ViewBag.DateFrom)" asp-route-dateTo="@(ViewBag.DateTo)">Товаров
        @if ((ViewBag.CurrentSort as string) == "Count") { <span>▲</span> }
        @if ((ViewBag.CurrentSort as string) == "count_desc") { <span>▼</span> }
    </a>
</th>
<th>
    <a asp-action="Index" asp-route-sortOrder="@(ViewBag.SumSortParm)" asp-route-customerId="@(ViewBag.SelectedCustomerId)" asp-route-status="@(ViewBag.SelectedStatus)" asp-route-dateFrom="@(ViewBag.DateFrom)" asp-route-dateTo="@(ViewBag.DateTo)">Сумма
        @if ((ViewBag.CurrentSort as string) == "Sum") { <span>▲</span> }
        @if ((ViewBag.CurrentSort as string) == "sum_desc") { <span>▼</span> }
    </a>
</th>
<th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
@foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.User.LastName @order.User.FirstName @order.User.Patronymic</td>
                    <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@order.Status.ToString().Replace("_", " ")</td>
                    <td>
                        @{
    var productNames = ViewBag.ProductNames as Dictionary<int, string>;
}
@if (order.Items != null && order.Items.Any())
{
    var itemTexts = new List<string>();
    foreach (var item in order.Items)
    {
        var productName = productNames != null && productNames.ContainsKey(item.ProductId) 
            ? productNames[item.ProductId] 
            : $"ID:{item.ProductId}";
        itemTexts.Add($"{productName} ×{item.Quantity}");
    }
    <text>@Html.Raw(string.Join(", ", itemTexts))</text>
}
                    </td>
                    <td>@((order.Items != null && order.Items.Count > 0) ? (order.Items.Sum(i => i.Price * i.Quantity).ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))) : "0 ₽")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-outline-warning btn-sm me-1" title="Редактировать">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@order.Id" class="btn btn-outline-danger btn-sm" title="Удалить">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>