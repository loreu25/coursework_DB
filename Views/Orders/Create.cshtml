@model InternetShop.Models.OrderCreateViewModel

@{
    ViewData["Title"] = "Создание заказа";
}

<h1>Создание заказа</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
        @foreach (var key in ViewData.ModelState.Keys)
        {
            var modelState = ViewData.ModelState[key];
            if (modelState?.Errors != null)
            {
                foreach (var error in modelState.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
        }
        </ul>
    </div>
}

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-4">
                <h5>Выберите товары для заказа</h5>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Цена</th>
                            <th>В наличии</th>
                            <th>Количество</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Products.Count; i++)
                        {
                            <tr>
                                <td>@Model.Products[i].Name</td>
                                <td>@Model.Products[i].Price.ToString("C")</td>
                                <td>@Model.Products[i].Stock</td>
                                <td style="width: 150px;">
                                    <input type="hidden" name="SelectedProducts[@i].ProductId" value="@Model.Products[i].Id" />
                                    <input type="number" name="SelectedProducts[@i].Quantity" value="0" min="0" max="@Model.Products[i].Stock" class="form-control" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Создать заказ</button>
                <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}