@model InternetShop.Models.Order

@{
    ViewData["Title"] = "Редактирование";
}

<h1>Редактирование</h1>

<h4>Заказ</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            @if (ViewBag.ModelStateErrors != null && ViewBag.ModelStateErrors.Count > 0)
            {
                <div class="alert alert-danger">
                    <ul>
                        @foreach (var error in ViewBag.ModelStateErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
            <!-- Убираем стандартный summary, так как используем ViewBag.ModelStateErrors -->
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label class="control-label">Пользователь</label>
                <input type="text" value="@Model.User.LastName @Model.User.FirstName @Model.User.Patronymic" class="form-control" readonly />
                <input type="hidden" asp-for="UserId" />
            </div>
            <div class="form-group">
                <label asp-for="OrderDate" class="control-label"></label>
                <input asp-for="OrderDate" class="form-control" />
                <span asp-validation-for="OrderDate" class="text-danger"></span>
            </div>
            <div class="form-group">
    <label asp-for="Status" class="control-label"></label>
    <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<InternetShop.Models.OrderStatus>()"></select>
    <span asp-validation-for="Status" class="text-danger"></span>
</div>
            <div class="form-group">
                <input type="submit" value="Сохранить" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Назад к списку</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
