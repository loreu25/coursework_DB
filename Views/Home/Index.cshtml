@{
    ViewData["Title"] = "Главная страница";
}

<div class="container-xl mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="display-4 text-center mb-4">Информационная система интернет-магазина</h1>
            <div class="row g-4">
                <div class="col-md-4">
                    <a href="/Customers" class="btn btn-outline-primary btn-lg w-100 py-4 shadow-sm">
                        <i class="bi bi-people-fill" style="font-size:2.5rem"></i><br />Клиенты
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="/Products" class="btn btn-outline-success btn-lg w-100 py-4 shadow-sm">
                        <i class="bi bi-box-seam" style="font-size:2.5rem"></i><br />Товары
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="/Orders" class="btn btn-outline-warning btn-lg w-100 py-4 shadow-sm">
                        <i class="bi bi-bag-check-fill" style="font-size:2.5rem"></i><br />Заказы
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
