@{
    ViewData["Title"] = "Главная";
}

<div class="container-xl mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (!User.Identity?.IsAuthenticated == true)
            {
                <div class="text-center">
                    <h1 class="display-4 mb-4">Информационная система учета заказов</h1>
                    <p class="lead mb-4">Для продолжения необходимо войти в систему</p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a href="/Account/Login" class="btn btn-primary btn-lg px-4 gap-3">
                            <i class="bi bi-box-arrow-in-right"></i> Войти
                        </a>
                        <a href="/Account/Register" class="btn btn-outline-secondary btn-lg px-4">
                            <i class="bi bi-person-plus"></i> Зарегистрироваться
                        </a>
                    </div>
                </div>
            }
            @if (User.IsInRole("Admin"))
            {
                <h1 class="display-4 text-center mb-4">Информационная система учета заказов</h1>
                <div class="row g-4">
                    <div class="col-md-4">
                        <a href="/Users" class="btn btn-outline-primary btn-lg w-100 py-4 shadow-sm">
                            <i class="bi bi-people-fill" style="font-size:2.5rem"></i><br />Пользователи
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/Products" class="btn btn-outline-success btn-lg w-100 py-4 shadow-sm">
                            <i class="bi bi-box-seam" style="font-size:2.5rem"></i><br />Товары
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/Orders" class="btn btn-outline-warning btn-lg w-100 py-4 shadow-sm">
                            <i class="bi bi-bag-check-fill" style="font-size:2.5rem"></i><br />Заказы
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
