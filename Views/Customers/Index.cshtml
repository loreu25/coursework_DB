@model IEnumerable<InternetShop.Models.Customer>

@{
    ViewData["Title"] = "Клиенты";
}

<h1>Клиенты</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Создать нового клиента</a>
</p>
<table class="table table-hover align-middle border rounded shadow-sm">
    <thead>
        <tr>
            <th>Имя</th>
<th>Email</th>
<th>Телефон</th>
<th>Действия</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm me-1" title="Редактировать"><i class="bi bi-pencil"></i> Редактировать</a>
<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-1" title="Подробнее"><i class="bi bi-eye"></i> Подробнее</a>
<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Удалить"><i class="bi bi-trash"></i> Удалить</a>
            </td>
        </tr>
}
    </tbody>
</table>